# HTTP local
CIC_PORT=9000
CIC_KHO=tep
CIC_TEP_DU_LIEU=dulieu/du-lieu.json

# Khoá dùng chung cho cả borrower mapping và intake quá hạn qua HTTPS.
# Để trống thì toàn bộ /api/v1/internal/* fail-closed với HTTP 403.
CIC_INTERNAL_API_KEY=

# Kafka chỉ dùng khi chạy Node dài hạn ở local/container; Vercel luôn dùng HTTP intake.
CIC_KAFKA_CONSUMER_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CIC_LOAN_DELINQUENCY_GROUP=cic-loan-delinquency
LOAN_DELINQUENCY_CHANGED_TOPIC=finora.loan.delinquency-changed

# Chính sách nợ xấu nội bộ FINORA, không phải thời hạn pháp luật ấn định.
CIC_BAD_DEBT_COOLDOWN_MONTHS=12
CIC_BAD_DEBT_MANUAL_REVIEW_MONTHS=24
CIC_CHO_PHEP_PII_TREN_BLOB_CONG_KHAI=false
